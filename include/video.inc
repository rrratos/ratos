; Таблица 1.1 - функции прерывания видео BIOS'а                              ;
;============================================================================;

  ;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  ;+ функция 0 - установка видеорежима                                     +
  ;+                                                                       +
  ;+     вход:   ah == 0 (номер функции),                                  +
  ;+             al (номер видеорежима, см. таблицу 1.2 стандартных        +
  ;+                                                        видеорежимов), +
  ;+     выход:  al - установленный видеорежим                             +
  ;+                  0x20 - режимы > 7                                    +
  ;+                  0x30 - режимы 0-5 и 7                                +
  ;+                  0x3F - режим 6                                       +
  ;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++


;============================================================================;
; Таблица 1.2 - стандартные видеорежимы видео BIOS'а                         ;
;============================================================================;

  ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  ;+ Номер   Тип     Разрешение       Цвета        Размер символа   Кол-во страниц    Адрес буфера  +
  ;+                                                (в пикселях)                                    +
  ;+------------------------------------------------------------------------------------------------+
  ;+   0    Текст     40x25     16 оттенки серого        8x8              8            0x0:0xB800   +
  ;+------------------------------------------------------------------------------------------------+
  ;+   1    Текст     40x25            16                8x8              8            0x0:0xB800   +
  ;+------------------------------------------------------------------------------------------------+
  ;+   2    Текст     80x25     16 оттенки серого        8x8              4            0x0:0xB800   +
  ;+------------------------------------------------------------------------------------------------+
  ;+   3    Текст     80x25            16                8x8              4            0x0:0xB800   +
  ;+------------------------------------------------------------------------------------------------+
  ;+   4    Графич   320x200            4                 *               *            0x0:0xB800   +
  ;+------------------------------------------------------------------------------------------------+
  ;+   5    Графич   320x200    4 оттенки серого          *               *            0x0:0xB800   +
  ;+------------------------------------------------------------------------------------------------+
  ;+   6    Графич   640x200            2                 *               *            0x0:0xB800   +
  ;+------------------------------------------------------------------------------------------------+
  ;+   7    Текст    640x200           Моно              9x14        по-разному        0x0:0xB000   +
  ;+------------------------------------------------------------------------------------------------+
  ;+   8                             Поддерживается только PCjr                                     +
  ;+------------------------------------------------------------------------------------------------+
  ;+   9                             Поддерживается только PCjr                                     +
  ;+------------------------------------------------------------------------------------------------+
  ;+   10                            Поддерживается только PCjr                                     +
  ;+------------------------------------------------------------------------------------------------+
  ;+   11                                 Зарезервировано                                           +
  ;+------------------------------------------------------------------------------------------------+
  ;+   12                                 Зарезервировано                                           +
  ;+------------------------------------------------------------------------------------------------+
  ;+   13    Графич  320x200            16                *               8             0x0:0xA000  +
  ;+------------------------------------------------------------------------------------------------+
  ;+   14    Графич  640x200            16                *               4             0x0:0xA000  +
  ;+------------------------------------------------------------------------------------------------+
  ;+   15    Графич  640x250           Моно               *               2             0x0:0xA000  +
  ;+------------------------------------------------------------------------------------------------+
  ;+   16    Графич  640x350            16                *               *             0x0:0xA000  +
  ;+------------------------------------------------------------------------------------------------+
  ;+   17    Графич  640x480           Моно               *               *             0x0:0xA000  +
  ;+------------------------------------------------------------------------------------------------+
  ;+   18    Графич  640x480            16                *               *             0x0:0xA000  +
  ;+------------------------------------------------------------------------------------------------+
  ;+   19    Графич  320x200            256               *               *             0x0:0xA000  +
  ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++


